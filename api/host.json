{
  "version": "2.0",
  "functionTimeout": "00:01:00",
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.0.0, 5.0.0)"
  },
  "logging": {
    "fileLoggingMode": "never",
    "logLevel": {
      "default": "None",
      "Function": "Error",
      "Host.Results": "None",
      "Host.Aggregator": "None"
    },
    "applicationInsights": {
      "enableLiveMetrics": false,
      "enableDependencyTracking": false
    }
  },
  "extensions": {
    "http": {
      "routePrefix": "api",
      "maxOutstandingRequests": 64,
      "maxConcurrentRequests": 4
    }
  }
}
